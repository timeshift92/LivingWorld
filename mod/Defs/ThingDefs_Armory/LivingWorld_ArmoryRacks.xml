<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="ShelfBase">
    <defName>LivingWorld_WeaponRack</defName>
    <label>weapon rack</label>
    <description>An armory rack for the colony's weapons. While the colony is stood down, mobilization weapons are kept here; when mobilized, combat-capable colonists come and arm themselves.</description>
    <thingClass>LivingWorld.RimWorld.Building_ArmoryRack</thingClass>
    <graphicData>
      <texPath>Things/Building/Furniture/Shelf</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3,2)</drawSize>
    </graphicData>
    <costStuffCount>25</costStuffCount>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <Mass>8</Mass>
      <WorkToBuild>600</WorkToBuild>
    </statBases>
    <size>(2,1)</size>
    <building>
      <fixedStorageSettings>
        <filter>
          <categories>
            <li>Weapons</li>
          </categories>
        </filter>
      </fixedStorageSettings>
      <defaultStorageSettings>
        <filter>
          <categories>
            <li>Weapons</li>
          </categories>
        </filter>
      </defaultStorageSettings>
    </building>
    <modExtensions>
      <li Class="LivingWorld.RimWorld.ArmoryRackExtension">
        <kind>Weapon</kind>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="ShelfBase">
    <defName>LivingWorld_ArmorRack</defName>
    <label>armor rack</label>
    <description>An armory rack for the colony's armour. While the colony is stood down, mobilization armour is kept here; when mobilized, combat-capable colonists come and don it.</description>
    <thingClass>LivingWorld.RimWorld.Building_ArmoryRack</thingClass>
    <graphicData>
      <texPath>Things/Building/Furniture/Shelf</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3,2)</drawSize>
    </graphicData>
    <costStuffCount>25</costStuffCount>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <Mass>8</Mass>
      <WorkToBuild>600</WorkToBuild>
    </statBases>
    <size>(2,1)</size>
    <building>
      <fixedStorageSettings>
        <filter>
          <categories>
            <li>ApparelArmor</li>
          </categories>
        </filter>
      </fixedStorageSettings>
      <defaultStorageSettings>
        <filter>
          <categories>
            <li>ApparelArmor</li>
          </categories>
        </filter>
      </defaultStorageSettings>
    </building>
    <modExtensions>
      <li Class="LivingWorld.RimWorld.ArmoryRackExtension">
        <kind>Armor</kind>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="ShelfBase">
    <defName>LivingWorld_ApparelRack</defName>
    <label>clothing rack</label>
    <description>An armory rack for the colony's civilian clothing. When colonists mobilize they leave their civvies here; on stand-down they change back.</description>
    <thingClass>LivingWorld.RimWorld.Building_ArmoryRack</thingClass>
    <graphicData>
      <texPath>Things/Building/Furniture/Shelf</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3,2)</drawSize>
    </graphicData>
    <costStuffCount>20</costStuffCount>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <Mass>8</Mass>
      <WorkToBuild>500</WorkToBuild>
    </statBases>
    <size>(2,1)</size>
    <building>
      <fixedStorageSettings>
        <filter>
          <categories>
            <li>ApparelMisc</li>
          </categories>
        </filter>
      </fixedStorageSettings>
      <defaultStorageSettings>
        <filter>
          <categories>
            <li>ApparelMisc</li>
          </categories>
        </filter>
      </defaultStorageSettings>
    </building>
    <modExtensions>
      <li Class="LivingWorld.RimWorld.ArmoryRackExtension">
        <kind>Apparel</kind>
      </li>
    </modExtensions>
  </ThingDef>

</Defs>
